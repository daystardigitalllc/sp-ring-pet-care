---
// BookingModal.astro
// Slide-up booking modal form. Any element on the page with [data-open-booking]
// will open this modal when clicked. Submits via Web3Forms.
import businessData from '../data/business.json';
---

<!-- Backdrop -->
<div
  id="booking-modal-backdrop"
  class="fixed inset-0 z-[200] bg-black/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Modal Panel -->
<div
  id="booking-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="booking-modal-title"
  class="fixed inset-x-0 bottom-0 z-[201] hidden translate-y-full transition-transform duration-400 ease-out max-w-lg mx-auto"
>
  <div class="bg-white rounded-t-3xl shadow-2xl px-6 pt-6 pb-10 relative">
    <!-- Drag handle -->
    <div class="w-10 h-1 rounded-full bg-slate-200 mx-auto mb-5"></div>

    <!-- Close button -->
    <button
      id="booking-modal-close"
      aria-label="Close booking form"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors"
    >
      <i class="fa-solid fa-xmark text-slate-500 text-sm"></i>
    </button>

    <h2 id="booking-modal-title" class="text-xl font-bold text-slate-900 mb-1">
      Book Pet Care
    </h2>
    <p class="text-xs text-slate-500 mb-6">
      We'll reach out within 24 hours to confirm your visit.
    </p>

    <!-- Form -->
    <form
      id="booking-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-4"
    >
      <!-- Web3Forms access key — replace with your own at web3forms.com -->
      <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
      <input type="hidden" name="subject" value={`New booking request — ${businessData.name}`} />
      <input type="hidden" name="redirect" value="false" />
      <input type="checkbox" name="botcheck" class="hidden" />

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="bm-name" class="block text-xs font-semibold text-slate-700 mb-1">Your Name</label>
          <input
            id="bm-name"
            name="name"
            type="text"
            required
            placeholder="Jane Smith"
            class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
          />
        </div>
        <div>
          <label for="bm-phone" class="block text-xs font-semibold text-slate-700 mb-1">Phone / Text</label>
          <input
            id="bm-phone"
            name="phone"
            type="tel"
            required
            placeholder="(931) 555-0000"
            class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
          />
        </div>
      </div>

      <div>
        <label for="bm-email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
        <input
          id="bm-email"
          name="email"
          type="email"
          placeholder="jane@example.com"
          class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="bm-pet-type" class="block text-xs font-semibold text-slate-700 mb-1">Pet Type</label>
          <select
            id="bm-pet-type"
            name="pet_type"
            class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
          >
            <option value="">Select...</option>
            <option>Dog</option>
            <option>Cat</option>
            <option>Dog & Cat</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="bm-service" class="block text-xs font-semibold text-slate-700 mb-1">Service Needed</label>
          <select
            id="bm-service"
            name="service"
            class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
          >
            <option value="">Select...</option>
            <option>Drop-in Visit</option>
            <option>Dog & Cat Sitting</option>
            <option>Dog Walking</option>
            <option>Overnight Boarding</option>
            <option>Medication Support</option>
          </select>
        </div>
      </div>

      <div>
        <label for="bm-dates" class="block text-xs font-semibold text-slate-700 mb-1">Requested Dates</label>
        <input
          id="bm-dates"
          name="dates"
          type="text"
          placeholder="Aug 15 – Aug 18"
          class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all"
        />
      </div>

      <div>
        <label for="bm-notes" class="block text-xs font-semibold text-slate-700 mb-1">Pet notes or medication details</label>
        <textarea
          id="bm-notes"
          name="notes"
          rows="3"
          placeholder="My dog takes seizure meds twice daily at 8am & 8pm…"
          class="w-full text-sm px-3 py-2.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none"
        ></textarea>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="booking-submit-btn"
        class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm tracking-wide transition-all shadow-md"
      >
        Send Booking Request
      </button>

      <!-- Success state -->
      <div id="booking-success" class="hidden text-center py-4 space-y-2">
        <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mx-auto">
          <i class="fa-solid fa-check text-green-600"></i>
        </div>
        <p class="font-bold text-slate-900">Request sent!</p>
        <p class="text-xs text-slate-500">We'll be in touch within 24 hours to confirm your pet care visit.</p>
      </div>
    </form>
  </div>
</div>

<script>
  const backdrop = document.getElementById('booking-modal-backdrop')!;
  const modal    = document.getElementById('booking-modal')!;
  const closeBtn = document.getElementById('booking-modal-close')!;
  const form     = document.getElementById('booking-form') as HTMLFormElement;
  const success  = document.getElementById('booking-success')!;
  const submitBtn = document.getElementById('booking-submit-btn')!;

  function openModal() {
    backdrop.classList.remove('hidden');
    modal.classList.remove('hidden');
    // Force reflow then animate in
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      modal.classList.remove('translate-y-full');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    modal.classList.add('translate-y-full');
    setTimeout(() => {
      backdrop.classList.add('hidden');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 350);
  }

  // Wire all [data-open-booking] triggers on the page
  document.querySelectorAll('[data-open-booking]').forEach((el) => {
    el.addEventListener('click', openModal);
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  // Handle form submit via fetch (Web3Forms JSON)
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Sending…';
    submitBtn.setAttribute('disabled', 'true');

    const data = new FormData(form);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      if (res.ok) {
        form.querySelector('button[type="submit"]')?.classList.add('hidden');
        success.classList.remove('hidden');
        // Auto close after 3s
        setTimeout(closeModal, 3000);
      } else {
        submitBtn.textContent = 'Try again';
        submitBtn.removeAttribute('disabled');
      }
    } catch {
      submitBtn.textContent = 'Try again';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
